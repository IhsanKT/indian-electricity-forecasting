# Data — never committed. Raw is re-downloadable from the Mendeley DOI (see docs/data_audit.md),
# processed is reproducible from raw via src/data/preprocess.py.
data/raw/
data/processed/

# Cached forecasts — large and reproducible from src/run_experiments.py.
results/*.parquet
results/eda/
# ...but the small result tables ARE the deliverable, so they stay in the repo:
!results/summary.csv
!results/error_by_horizon.csv
!results/run_metadata.json
!results/lightgbm_tuning.json

# Model checkpoints (TimesFM 2.5 ~400MB). Anchored with a leading slash: a bare "models/"
# also matches src/models/, which silently dropped the entire model package from the repo.
/models/
*.ckpt
*.safetensors
.cache/
huggingface/

